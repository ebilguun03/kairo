# ─────────────────────────────────────────────────────────────────
# Kairo — environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.
# Required for chat: Supabase URL, anon key, service-role key, and Anthropic key.
# Replace every YOUR_* placeholder locally; placeholders are not working keys.
# Keep SUPABASE_SERVICE_ROLE_KEY and ANTHROPIC_API_KEY server-side only.
# ─────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com → your project → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-6

# Web chat (the primary demo transport)
# - KAIRO_DEMO_RESTAURANT_SLUG: which restaurant the /chat page acts on behalf of.
#   Defaults to "paper-lantern-demo". Matches a row in supabase `restaurants.slug`.
# - KAIRO_CHAT_PASSWORD: optional shared password. If set, /chat requires it
#   (sent as `Authorization: Bearer <password>`). Use this to gate the public
#   URL during the capstone demo so random visitors can't run up your Claude bill.
#   Leaving it blank opens both chat and demo-context APIs. Set a strong, unique
#   password before deploying with private data or a paid Anthropic key.
KAIRO_DEMO_RESTAURANT_SLUG=paper-lantern-demo
KAIRO_CHAT_PASSWORD=

# Slack (OPTIONAL — secondary transport. Leave blank to deploy without Slack.)
# When unset, /api/slack/events returns 503 and the rest of the app still works.
# See docs/slack-app-setup.md when you're ready to wire it up.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_ID=

# Toast POS (https://pos.toasttab.com → Toast Developer Portal)
# Apply for partner access; for local dev you can stub this.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_WEBHOOK_SECRET=

# Twilio (SMS — A2P 10DLC registration required for production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Resend (email)
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=hello@example.com

# PostHog (product analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com
